#!/usr/bin/env bash

###############################################################################
# VARIABLES
###############################################################################

cwd="$(cd "$(dirname "$0")" && pwd)"
count=1
DRY_RUN=${DRY_RUN:-false}

bold=$(tput bold 2>/dev/null)
normal=$(tput sgr0 2>/dev/null)
reset="$normal"
dim=$(tput dim 2>/dev/null)
underline=$(tput smul 2>/dev/null)

color_red=$(tput setaf 1 2>/dev/null)
color_green=$(tput setaf 2 2>/dev/null)
color_yellow=$(tput setaf 3 2>/dev/null)
color_blue=$(tput setaf 4 2>/dev/null)

dot="${color_red}▸${reset} "

###############################################################################
# Utility Functions
###############################################################################
_print_in_color() {
    printf "%b" \
        "$(tput setaf "$2" 2> /dev/null)" \
        "$1" \
        "$(tput sgr0 2> /dev/null)"
}

# NOTE: not being used
_print_error_stream() {
    while read -r line; do
        print_in_red "     ↳ ERROR: $line\n"
    done
}

# NOTE: not being used
_kill_all_subprocesses() {

    local i=""

    for i in $(jobs -p); do
        kill "$i"
        wait "$i" &> /dev/null
    done

}

# NOTE: not being used
_set_trap() {

    trap -p "$1" | grep "$2" &> /dev/null \
        || trap '$2' "$1"

}

# NOTE: replace with GNU Stow
_link_file() {
  local src=$1 dst=$2

  local overwrite= backup= skip=
  local action=

  if [ -f "$dst" -o -d "$dst" -o -L "$dst" ]
  then

    if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
    then

      local currentSrc="$(readlink $dst)"

      if [ "$currentSrc" == "$src" ]
      then

        skip=true;

      else

        printf "\r   ${yellow}!${reset} File already exists: $dst ($(basename "$src")), what do you want to do?
     [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all? "
        read -n 1 action

        case "$action" in
          o )
            overwrite=true;;
          O )
            overwrite_all=true;;
          b )
            backup=true;;
          B )
            backup_all=true;;
          s )
            skip=true;;
          S )
            skip_all=true;;
          * )
            ;;
        esac

      fi

    fi

    overwrite=${overwrite:-$overwrite_all}
    backup=${backup:-$backup_all}
    skip=${skip:-$skip_all}

    if [ "$overwrite" == "true" ]
    then
      rm -rf "$dst"
      print_in_green "\n      ✓ deleted $dst"
    fi

    if [ "$backup" == "true" ]
    then
      mv "$dst" "${dst}.backup"
      print_in_green "\n      ✓ moved $dst to ${dst}.backup"
    fi

    if [ "$skip" == "true" ]
    then
      printf "\n  ${dim}    ✓ $src already linked. Skipped.${reset}"
    fi
  fi

  if [ "$skip" != "true" ]  # "false" or empty
  then
    ln -s "$1" "$2"
    print_in_green "\n      ✓ linked $1 to $2"
  fi
}

###############################################################################
# Print Functions
###############################################################################

print_in_red() {
    _print_in_color "$1" 1
}

print_in_green() {
    _print_in_color "$1" 2
}

print_in_yellow() {
    _print_in_color "$1" 3
}

print_in_blue() {
    _print_in_color "$1" 4
}

print_in_purple() {
    _print_in_color "$1" 5
}

print_in_cyan() {
    _print_in_color "$1" 6
}

print_in_white() {
    _print_in_color "$1" 7
}

print_result() {

    if [ "$1" -eq 0 ]; then
        print_success "$2"
    else
        print_error "$2"
    fi

    return "$1"

}

print_question() {
    print_in_yellow "  [?] $1\n"
}

print_success() {
    print_in_green "  [✓] $1\n"
}

print_success_muted() {
    printf "  ${dim}[✓] $1${reset}\n" "$@"
}

print_muted() {
    printf "  ${dim}$1${reset}\n" "$@"
}

print_warning() {
    print_in_yellow "  [!] $1\n"
}

print_error() {
    print_in_red "  [𝘅] $1 $2\n"
}

###############################################################################
# Meta Checks
###############################################################################

check_macos() {
	if [ "$(uname -s)" != "Darwin" ]; then
		print_error "Ando is only intended for MacOS"
		exit 1
	fi
}

check_internet_connection() {
	if ping -q -W1 -c1 google.com &>/dev/null; then
		print_success "Internet connection"
	else
		print_error "Please check your internet connection"
		exit 1
	fi
}

###############################################################################
# Dotfiles
###############################################################################
setup_dotfiles() {
	print_question "How do you want to handle dotfiles?"
	echo "     1) Symlink from Ando's built-in dotfiles/ directory"
	echo "     2) Symlink from a custom directory"
	echo "     3) Skip for now (choose if using GNU Stow)"

	local choice
	read -r -p "  Choice [1-3]: " choice </dev/tty

	case "$choice" in
		1)
			link_dotfiles_from "$cwd/dotfiles" ;;
		2)
			local custom_dir
			read -r -p "  Path to your dotfiles directory: " custom_dir </dev/tty
			link_dotfiles_from "$custom_dir" ;;
		3)
			print_muted "Skipping dotfiles for now." ;;
		*)
			print_error "Invalid choice."
			return 1 
            ;;
	esac
}

link_dotfiles_from() {
	local source_dir="$1"
	local entry

	while IFS= read -r entry; do
		link_dotfile "$source_dir/$entry" "$HOME/$entry"
	done < <(read_materials_file "$cwd/materials/dotfiles")
}

link_dotfile() {
	local src="$1"
	local dst="$2"

	if [ ! -e "$src" ]; then
		print_error "Missing source: $src"
		return 1
	fi

	if [ -e "$dst" ] || [ -L "$dst" ]; then
		if [ "$(readlink "$dst")" = "$src" ]; then
			print_success_muted "$(basename "$dst") already linked. Skipped."
			return 0
		fi

		if ask "$(basename "$dst") already exists. Overwrite?" N; then
			rm -rf "$dst"
		else
			print_muted "Skipped $(basename "$dst")"
			return 0
		fi
	fi

	mkdir -p "$(dirname "$dst")"
	ln -s "$src" "$dst"
	print_success "Linked $(basename "$dst")"
}


###############################################################################
# Prompts
###############################################################################
ask_for_sudo() {

    # Ask for the administrator password upfront.

    sudo -v &> /dev/null

    # Update existing `sudo` time stamp
    # until this script has finished.
    #
    # https://gist.github.com/cowboy/3118588

    # Keep-alive: update existing `sudo` time stamp until script has finished
    while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

    print_success "Password cached"

}

ask() {
    # https://djm.me/ask
    local prompt default reply

    while true; do

        if [ "${2:-}" = "Y" ]; then
            prompt="Y/n"
            default=Y
        elif [ "${2:-}" = "N" ]; then
            prompt="y/N"
            default=N
        else
            prompt="y/n"
            default=
        fi

        # Ask the question (not using "read -p" as it uses stderr not stdout)
        echo -n "  [?] $1 [$prompt] "

        # Read the answer (use /dev/tty in case stdin is redirected from somewhere else)
        read reply </dev/tty

        # Default?
        if [ -z "$reply" ]; then
            reply=$default
        fi

        # Check if the reply is valid
        case "$reply" in
            Y*|y*) return 0 ;;
            N*|n*) return 1 ;;
        esac

    done
}


###############################################################################
# SSH KEY SETUP
###############################################################################

ssh_key_setup() {
	local pub="$HOME/.ssh/id_ed25519.pub"

	if [ -f "$pub" ]; then
		print_success_muted "SSH key already exists. Skipping."
		return 0
	fi

	print_question "How do you want to set up SSH access to GitHub?"
	echo "     1) 1Password SSH agent"
	echo "     2) gh auth login (GitHub CLI)"
	echo "     3) ssh-keygen (ed25519, manual)"
	echo "     4) Skip for now"

	local choice
	read -r -p "  Choice [1-4]: " choice </dev/tty

	case "$choice" in
		1) ssh_setup_1password ;;
		2) ssh_setup_gh ;;
		3) ssh_setup_keygen ;;
		*) print_muted "Skipping SSH setup." ;;
	esac
}

ssh_setup_1password() {
	print_muted "In 1Password: Settings > Developer > enable the SSH agent, then create/import a key."
	print_muted "Add to ~/.ssh/config:"
	print_muted "  Host *"
	print_muted "    IdentityAgent \"~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock\""
	print_success "1Password SSH agent instructions shown"
}

ssh_setup_gh() {
	if ! command -v gh &>/dev/null; then
		print_warning "gh is not installed. Add it to brew-formulae and re-run."
		return 1
	fi

	if [ "$DRY_RUN" == "true" ]; then
		print_dry_run "gh auth login"
	else
		gh auth login
		print_success "GitHub CLI authenticated"
	fi
}

ssh_setup_keygen() {
	if [ "$DRY_RUN" == "true" ]; then
		print_dry_run "ssh-keygen -t ed25519"
		return 0
	fi

	ssh-keygen -t ed25519

	if command -v pbcopy &>/dev/null; then
		pbcopy < "$HOME/.ssh/id_ed25519.pub"
		print_muted "Public key copied to clipboard."
	fi

	open "https://github.com/settings/keys" 2>/dev/null || true
	read -r -p "   Add it to GitHub, then press enter to continue..." </dev/tty
	print_success "SSH key added"
}

###############################################################################
# MATERIALS FILE READER
# Reads a file inside /materials, ignoring blank lines and comments
###############################################################################

read_materials_file() {
	local file="$1" line

	[ -f "$file" ] || return 0

	while IFS= read -r line || [ -n "$line" ]; do
		line="${line#"${line%%[![:space:]]*}"}"   # trim leading whitespace
		line="${line%"${line##*[![:space:]]}"}"   # trim trailing whitespace

		[ -z "$line" ] && continue
		[[ "$line" == \#* ]] && continue

		printf "%s\n" "$line"
	done < "$file"
}


###############################################################################
# INSTALLERS
###############################################################################

install_brew_formula() {
	local formula="$1"

	if brew list --formula 2>/dev/null | grep -qx "$formula"; then
		print_success_muted "$formula already installed. Skipped."
		return 0
	fi

	echo_install "Installing $formula"
	brew install "$formula" &>/dev/null
	print_success "$formula installed!"
}

install_brew_tap() {
	local tap="$1"

	if brew tap 2>/dev/null | grep -qx "$tap"; then
		print_success_muted "$tap already tapped. Skipped."
		return 0
	fi

	echo_install "Tapping $tap"
	brew tap "$tap" &>/dev/null
	print_success "$tap tapped!"
}

install_brew_cask() {
	local cask="$1"

	if brew list --cask 2>/dev/null | grep -qx "$cask"; then
		print_success_muted "$cask already installed. Skipped."
		return 0
	fi

	echo_install "Installing $cask"
	brew install --cask "$cask" --appdir=/Applications &>/dev/null
	print_success "$cask installed!"
}

install_app_store_app() {
	# entry format: "id::name"
	local entry="$1"
	local id="${entry%%::*}"
	local name="${entry##*::}"

	if ! command -v mas &>/dev/null; then
		print_warning "mas is not installed. Add it to brew-formulae and re-run."
		return 1
	fi

	if ! mas account &>/dev/null; then
		print_warning "Please sign in to the App Store first. Skipping."
		return 1
	fi

	if mas list 2>/dev/null | grep -q "^$id "; then
		print_success_muted "$name already installed. Skipped."
		return 0
	fi

	echo_install "Installing $name"
	mas install "$id" &>/dev/null
	print_success "$name installed!"
}

install_npm_package() {
	# entry format: "package" or "package::command"
	local entry="$1"
	local package="${entry%%::*}"
	local cmd="${entry##*::}"

	if command -v "$cmd" &>/dev/null; then
		print_success_muted "$package already installed. Skipped."
		return 0
	fi

	echo_install "Installing $package"
	npm install -g "$package" --silent
	print_success "$package installed!"
}

install_pipx_package() {
	# entry format: "package" or "package::command"
	local entry="$1"
	local package="${entry%%::*}"
	local cmd="${entry##*::}"

	if command -v "$cmd" &>/dev/null; then
		print_success_muted "$package already installed. Skipped."
		return 0
	fi

	echo_install "Installing $package"
	pipx install "$package" &>/dev/null
	print_success "$package installed!"
}


