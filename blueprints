#!/usr/bin/env bash

###############################################################################
# Variables
###############################################################################

cwd="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
count=1
DRY_RUN=${DRY_RUN:-false}

bold=$(tput bold 2>/dev/null)
reset=$(tput sgr0 2>/dev/null)
dim=$(tput dim 2>/dev/null)
underline=$(tput smul 2>/dev/null)

color_red=$(tput setaf 1 2>/dev/null)
color_green=$(tput setaf 2 2>/dev/null)
color_yellow=$(tput setaf 3 2>/dev/null)

dot="${color_red}▸${reset} "


###############################################################################
# Utility Functions
###############################################################################

_print_in_color() {
    printf "%b" \
        "$(tput setaf "$2" 2> /dev/null)" \
        "$1" \
        "$(tput sgr0 2> /dev/null)"
}

print_dry_run() {
	printf "  ${dim}[dry-run] %s${reset}\n" "$1"
}

run_step() {
	local description="$1"; shift
	[ "$1" == "--" ] && shift

	if [ "$DRY_RUN" == "true" ]; then
		print_dry_run "$description"
		return 0
	fi

	"$@"
}


###############################################################################
# Print Functions
###############################################################################

print_in_red() {
    _print_in_color "$1" 1
}

print_in_green() {
    _print_in_color "$1" 2
}

print_in_yellow() {
    _print_in_color "$1" 3
}

print_question() {
    print_in_yellow "  [?] $1\n"
}

print_success() {
    print_in_green "  [✓] $1\n"
}

print_success_muted() {
    printf "  ${dim}[✓] $1${reset}\n" "$@"
}

print_muted() {
    printf "  ${dim}$1${reset}\n" "$@"
}

print_warning() {
    print_in_yellow "  [!] $1\n"
}

print_error() {
    print_in_red "  [𝘅] $*\n"
}


###############################################################################
# Meta Checks
###############################################################################

check_macos() {
	if [ "$(uname -s)" != "Darwin" ]; then
		print_error "Ando is only intended for macOS"
		exit 1
	fi
}

check_internet_connection() {
	if ping -q -W1 -c1 google.com &>/dev/null; then
		print_success "Internet connection"
		return 0
	else
		return 1
	fi
}


###############################################################################
# Prerequisite Checks
###############################################################################

check_xcode_clt() {
	local clt_path

	if clt_path=$(xcode-select --print-path 2>/dev/null) && [ -d "$clt_path" ]; then
		print_success_muted "Xcode Command Line Tools already installed. Skipping."
		return 0
	fi

	if [ "$DRY_RUN" == "true" ]; then
		print_dry_run "xcode-select --install"
		return 0
	fi

	if [ -z "$XCODE_CLT_TRIGGERED" ]; then
		step "Installing Xcode Command Line Tools..."
		xcode-select --install 2>/dev/null || true
		XCODE_CLT_TRIGGERED=1
		print_muted "Complete the installation in the dialog that opened, then retry."
	fi

	return 1
}

check_homebrew() {
	if command -v brew >/dev/null 2>&1; then
		print_success_muted "Homebrew already installed. Skipping."
		return 0
	fi

	step "Installing Homebrew..."

	if [ "$DRY_RUN" == "true" ]; then
		print_dry_run "install Homebrew (NONINTERACTIVE=1 /bin/bash -c \"\$(curl -fsSL .../install.sh)\")"
		return 0
	fi

	if env NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"; then
		print_success "Homebrew installed!"
	else
		print_error "Homebrew failed to install"
		return 1
	fi
}


###############################################################################
# Dotfiles
###############################################################################

setup_dotfiles() {
	print_question "How do you want to handle dotfiles?"
	echo "     1) Symlink from Ando's built-in dotfiles/ directory"
	echo "     2) Symlink from a custom directory"
	echo "     3) Skip for now (choose if using GNU Stow)"

	local choice
	read -r -p "  Choice [1-3]: " choice </dev/tty

	case "$choice" in
		1)
			link_dotfiles_from "$cwd/dotfiles" ;;
		2)
			local custom_dir
			read -r -p "  Path to your dotfiles directory: " custom_dir </dev/tty
			link_dotfiles_from "$custom_dir" ;;
		3)
			print_muted "Skipping dotfiles for now." ;;
		*)
			print_error "Invalid choice."
			return 1 
            ;;
	esac
}

link_dotfiles_from() {
	local source_dir="$1"
	local entry

	while IFS= read -r entry; do
		link_dotfile "$source_dir/$entry" "$HOME/$entry"
	done < <(read_materials_file "$cwd/materials/dotfiles")
}

link_dotfile() {
	local src="$1"
	local dst="$2"

	if [ ! -e "$src" ]; then
		print_error "Missing source: $src"
		return 1
	fi

	if [ -e "$dst" ] || [ -L "$dst" ]; then
		if [ "$(readlink "$dst")" = "$src" ]; then
			print_success_muted "$(basename "$dst") already linked. Skipped."
			return 0
		fi

		if ask "$(basename "$dst") already exists. Overwrite?" N; then
			rm -rf "$dst"
		else
			print_muted "Skipped $(basename "$dst")"
			return 0
		fi
	fi

	mkdir -p "$(dirname "$dst")"
	if run_step "ln -s $src $dst" -- ln -s "$src" "$dst"; then
		print_success "Linked $(basename "$dst")"
	else
		print_error "Failed to link $(basename "$dst")"
		return 1
	fi
}


###############################################################################
# MacOS Settings
###############################################################################

apply_macos_settings() {
	local settings_file="$cwd/materials/macos-settings"

	if [ ! -f "$settings_file" ]; then
		return 0
	fi

	if ask "Apply macOS settings (Finder, Dock, trackpad, hot corners, etc.)?" Y; then
		if run_step "bash $settings_file" -- bash "$settings_file"; then
			print_success "macOS settings applied"
		else
			print_error "Failed to apply macOS settings"
			return 1
		fi
	else
		print_muted "Skipped macOS settings."
	fi
}


###############################################################################
# Prompts
###############################################################################

ask_for_sudo() {
	if ! sudo -v >/dev/null 2>&1; then
		print_error "Unable to obtain sudo privileges"
		return 1
	fi

	while true; do
		sudo -n true
		sleep 60
		kill -0 "$$" || exit
	done 2>/dev/null &

	print_success "Password cached"
}

ask() {
    local prompt default reply

    while true; do

        if [ "${2:-}" = "Y" ]; then
            prompt="Y/n"
            default=Y
        elif [ "${2:-}" = "N" ]; then
            prompt="y/N"
            default=N
        else
            prompt="y/n"
            default=
        fi

        echo -n "  [?] $1 [$prompt] "

        read -r reply </dev/tty

        if [ -z "$reply" ]; then
            reply=$default
        fi

        case "$reply" in
            Y*|y*) return 0 ;;
            N*|n*) return 1 ;;
        esac

    done
}

###############################################################################
# Critical Checks
###############################################################################

require_critical() {
	local description="$1"; shift

	until "$@"; do
		print_error "$description failed."

		if ask "Resolve it, then retry?" Y; then
			continue
		fi

		print_error "Cannot continue without $description. Exiting."
		exit 1
	done
}


###############################################################################
# SSH Key Setup
###############################################################################

ssh_key_setup() {
	local pub="$HOME/.ssh/id_ed25519.pub"

	if [ -f "$pub" ]; then
		print_success_muted "SSH key already exists. Skipping."
		return 0
	fi

	print_question "How do you want to set up SSH access to GitHub?"
	echo "     1) 1Password SSH agent"
	echo "     2) gh auth login (GitHub CLI)"
	echo "     3) ssh-keygen (ed25519, manual)"
	echo "     4) Skip for now"

	local choice
	read -r -p "  Choice [1-4]: " choice </dev/tty

	case "$choice" in
		1) ssh_setup_1password ;;
		2) ssh_setup_gh ;;
		3) ssh_setup_keygen ;;
		*) print_muted "Skipping SSH setup." ;;
	esac
}

ssh_setup_1password() {
	print_muted "In 1Password: Settings > Developer > enable the SSH agent, then create/import a key."
	print_muted "Add to ~/.ssh/config:"
	print_muted "  Host *"
	print_muted "    IdentityAgent \"~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock\""
	print_success "1Password SSH agent instructions shown"
}

ssh_setup_gh() {
	if ! command -v gh &>/dev/null; then
		print_warning "gh is not installed. Add it to brew-formulae and re-run."
		return 1
	fi

	if [ "$DRY_RUN" == "true" ]; then
		print_dry_run "gh auth login"
	else
		if gh auth login; then
			print_success "GitHub CLI authenticated"
		else
			print_error "GitHub CLI authentication failed"
			return 1
		fi
	fi
}

ssh_setup_keygen() {
	if [ "$DRY_RUN" == "true" ]; then
		print_dry_run "ssh-keygen -t ed25519"
		return 0
	fi

	if ! ssh-keygen -t ed25519; then
		print_error "SSH key generation failed"
		return 1
	fi

	if command -v pbcopy &>/dev/null; then
		pbcopy < "$HOME/.ssh/id_ed25519.pub"
		print_muted "Public key copied to clipboard."
	fi

	open "https://github.com/settings/keys" 2>/dev/null || true
	read -r -p "   Add it to GitHub, then press enter to continue..." </dev/tty
	print_success "SSH key added"
}


###############################################################################
# Materials File Reader
###############################################################################

# Reads a file inside /materials, ignoring blank lines and comments
read_materials_file() {
	local file="$1" line

	[ -f "$file" ] || return 0

	while IFS= read -r line || [ -n "$line" ]; do
		line="${line#"${line%%[![:space:]]*}"}"   # trim leading whitespace
		line="${line%"${line##*[![:space:]]}"}"   # trim trailing whitespace

		[ -z "$line" ] && continue
		[[ "$line" == \#* ]] && continue

		printf "%s\n" "$line"
	done < "$file"
}


###############################################################################
# Installers
###############################################################################

install_brew_formula() {
	local formula="$1"

	if brew list --formula "$formula" >/dev/null 2>&1; then
		print_success_muted "$formula already installed. Skipped."
		return 0
	fi

	echo_install "Installing $formula"

	if run_step "brew install $formula" -- brew install "$formula"; then
		print_success "$formula installed!"
	else
		print_error "$formula failed to install"
		return 1
	fi
}

install_brew_tap() {
	local tap="$1"

	if brew tap | grep -qx "$tap"; then
		print_success_muted "$tap already tapped. Skipped."
		return 0
	fi

	echo_install "Tapping $tap"

	if run_step "brew tap $tap" -- brew tap "$tap"; then
		print_success "$tap tapped!"
	else
		print_error "$tap failed to tap"
		return 1
	fi
}

install_brew_cask() {
	local cask="$1"

	if brew list --cask "$cask" >/dev/null 2>&1; then
		print_success_muted "$cask already installed. Skipped."
		return 0
	fi

	echo_install "Installing $cask"

	if run_step "brew install --cask $cask" -- brew install --cask "$cask" --appdir=/Applications; then
		print_success "$cask installed!"
	else
		print_error "$cask failed to install"
		return 1
	fi
}

check_mas_signed_in() {
	if ! command -v mas >/dev/null 2>&1; then
		print_error "mas is not installed. Add it to brew-formulae and re-run Ando."
		return 1
	fi

	if mas account >/dev/null 2>&1; then
		print_success_muted "Signed in to the App Store."
		return 0
	fi

	print_muted "Sign in to the App Store app, then retry."
	return 1
}

install_app_store_app() {
	local entry="$1"
	local id="${entry%%::*}"
	local name="${entry##*::}"

	if ! command -v mas >/dev/null 2>&1; then
		print_warning "mas is not installed. Add it to brew-formulae and re-run."
		return 1
	fi

	if ! mas account >/dev/null 2>&1; then
		print_warning "Please sign in to the App Store first. Skipping."
		return 1
	fi

	if mas list 2>/dev/null | awk '{print $1}' | grep -qx "$id"; then
		print_success_muted "$name already installed. Skipped."
		return 0
	fi

	echo_install "Installing $name"

	if run_step "mas install $id" -- mas install "$id"; then
		print_success "$name installed!"
	else
		print_error "$name failed to install"
		return 1
	fi
}

install_npm_package() {
	local entry="$1"
	local package="${entry%%::*}"
	local cmd="${entry##*::}"

	if command -v "$cmd" >/dev/null 2>&1; then
		print_success_muted "$package already installed. Skipped."
		return 0
	fi

	echo_install "Installing $package"

	if run_step "npm install -g $package" -- npm install -g "$package" --silent; then
		print_success "$package installed!"
	else
		print_error "$package failed to install"
		return 1
	fi
}

install_pipx_package() {
	local entry="$1"
	local package="${entry%%::*}"
	local cmd="${entry##*::}"

	if command -v "$cmd" >/dev/null 2>&1; then
		print_success_muted "$package already installed. Skipped."
		return 0
	fi

	echo_install "Installing $package"

	if run_step "pipx install $package" -- pipx install "$package"; then
		print_success "$package installed!"
	else
		print_error "$package failed to install"
		return 1
	fi
}


###############################################################################
# Text Formatting
###############################################################################

chapter() {
    local fmt="$1"; shift
    printf "\n✦  ${bold}$((count++)). $fmt${reset}\n└─────────────────────────────────────────────────────○\n" "$@"
}

echo_install() {
    local fmt="$1"; shift
    printf "  [↓] $fmt " "$@"
}

step() {
    printf "\n   ${dot}${underline}%s${reset}\n" "$*"
}

e_all_finished() {
    printf "
  ${bold}Everything is installed. Make Ando proud. ${reset} 
"
}
