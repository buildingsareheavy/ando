#!/usr/bin/env bash

###############################################################################
# ERROR HANDLING
###############################################################################

handle_exit() {
	local ret=$?

	if [ "$ret" -ne 0 ]; then
		print_error "Ando exited unexpectedly (exit code: $ret)"
	fi

	exit "$ret"
}

handle_interrupt() {
	printf "\n"
	print_warning "User has interrupted Ando"
	exit 130
}

trap handle_exit EXIT
trap handle_interrupt INT TERM

###############################################################################
# BLUEPRINTS: Check for required functions file
###############################################################################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -e "$SCRIPT_DIR/blueprints" ]; then
	. "$SCRIPT_DIR/blueprints"
else
	printf "\n ⚠️  ./blueprints not found. \n"
	exit 1
fi

###############################################################################
# LOG: Every run is saved to ~/ando.log
###############################################################################
LOG_FILE="$HOME/ando.log"
exec > >(tee "$LOG_FILE") 2>&1

###############################################################################
# STATE: Track failures to report at the end instead of aborting immediately
###############################################################################
FAILED_ITEMS=()

track_failure() {
	local description="$1"; shift

	if ! "$@"; then
		FAILED_ITEMS+=("$description")
	fi
}

###############################################################################
# Go Ando Go!          https://www.ascii-art-generator.org/ ( font: Slant )
###############################################################################

printf "       

    ___       _   __   ____     _____
   /   |     / | / /  / __ \   / __  /
  / /| |    /  |/ /  / / / /  / / / /
 / ___ |   / /|  /  / /_/ /  / /_/ / 
/_/  |_|  /_/ |_/  /_____/   \____/  
                                       
╭───────────────────────────────────────────────────╮
│  Safe to run multiple times on the same machine.  │
│  It ${green}installs${reset}, ${blue}upgrades${reset}, or ${yellow}skips${reset} packages based   │
│  on what is already installed on the machine.     │
╰───────────────────────────────────────────────────╯
   ${dim}$(check_macos)${reset}
"

if [ "$DRY_RUN" == "true" ]; then
	printf "  ${color_yellow}[using dry-run mode. Ando will not install or change anything]${reset}\n"
fi

###############################################################################
# CHECK: Internet
###############################################################################
chapter "Checking internet connection..."
check_internet_connection

###############################################################################
# PROMPT: Password
###############################################################################
chapter "Caching password..."
ask_for_sudo

###############################################################################
# PROMPT: SSH Key
###############################################################################
chapter 'Checking for SSH key...'
ssh_key_setup || true

###############################################################################
# INSTALL: Prerequisites
###############################################################################
chapter "Installing prerequisites..."
track_failure "Xcode Command Line Tools" check_xcode_clt
track_failure "Homebrew" check_homebrew

###############################################################################
# INSTALL: formulae
###############################################################################
if [ -e $cwd/materials/brew-formulae ]; then
	chapter "Installing Homebrew formulae..."

	while IFS= read -r formula; do
		track_failure "brew formula: $formula" install_brew_formula "$formula"
	done < <(read_materials_file "$cwd/materials/brew-formulae")
fi

###############################################################################
# INSTALL: casks
###############################################################################
if [ -e $cwd/materials/brew-casks ]; then
	chapter "Installing apps via Homebrew..."

	while IFS= read -r cask; do
		track_failure "brew cask: $cask" install_brew_cask "$cask"
	done < <(read_materials_file "$cwd/materials/brew-casks")
fi

###############################################################################
# INSTALL: brew taps
###############################################################################
if [ -e $cwd/materials/brew-taps ]; then
	chapter "Installing Homebrew taps..."

	while IFS= read -r tap; do
		track_failure "brew tap: $tap" install_brew_tap "$tap"
	done < <(read_materials_file "$cwd/materials/brew-taps")
fi


###############################################################################
# UPDATE: Homebrew
###############################################################################
chapter "Updating Homebrew formulae..."
brew update


###############################################################################
# INSTALL: Mac App Store Apps
###############################################################################
if [ -e $cwd/materials/app-store ]; then
	chapter "Installing apps from the App Store..."

	while IFS= read -r app; do
		track_failure "App Store: ${app##*::}" install_app_store_app "$app"
	done < <(read_materials_file "$cwd/materials/app-store")
fi

###############################################################################
# CLEAN: Homebrew files
###############################################################################
chapter "Cleaning up Homebrew files..."
brew cleanup 2> /dev/null

###############################################################################
# INSTALL: npm packages
###############################################################################
if [ -e $cwd/materials/npm-packages ]; then
	chapter "Installing npm packages..."

	while IFS= read -r pkg; do
		track_failure "npm: ${pkg%%::*}" install_npm_package "$pkg"
	done < <(read_materials_file "$cwd/materials/npm-packages")
fi

###############################################################################
# INSTALL: pipx packages
###############################################################################
if [ -e $cwd/materials/pipx-packages ]; then
	chapter "Installing pipx packages..."

	while IFS= read -r pkg; do
		track_failure "pipx: ${pkg%%::*}" install_pipx_package "$pkg"
	done < <(read_materials_file "$cwd/materials/pipx-packages")
fi

###############################################################################
# MANUAL INSTALL: reference-only reminders
###############################################################################
if [ -e $cwd/materials/manual-install ]; then
	chapter "Manual installs..."
	print_muted "Ando asks that you install these yourself later:"

	while IFS= read -r item; do
		print_muted "  • $item"
	done < <(read_materials_file "$cwd/materials/manual-install")
fi

###############################################################################
# DOTFILES
###############################################################################
chapter "Setting up dotfiles..."
track_failure "dotfiles" setup_dotfiles

###############################################################################
# MACOS SETTINGS
###############################################################################
chapter "macOS settings..."
apply_macos_settings

###############################################################################
# SUMMARY
###############################################################################
chapter "Summary"

if [ "${#FAILED_ITEMS[@]}" -eq 0 ]; then
	print_success "Everything ran clean — no failures."
else
	print_error "${#FAILED_ITEMS[@]} item(s) failed:"
	for item in "${FAILED_ITEMS[@]}"; do
		print_muted "  • $item"
	done
fi

print_muted "Full log saved to $LOG_FILE"

###############################################################################
# END
###############################################################################
e_all_finished
